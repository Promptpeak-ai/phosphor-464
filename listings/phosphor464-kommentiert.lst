  980                                          ; BODENLICHT DURCH PALETTE. Dreimal RRCA und AND 15 ergeben
  981                                          ; (phase >> 3) AND 15. Aus der wiederholten Farbliste wandert dadurch ein
  982                                          ; Fenster von sechs Eintraegen, ein Schritt pro acht Videoframes.
  983                                          ; Die Bildbytes bleiben gleich. Pens 7..12 wechseln ihre Hardwarefarbe.
  984 4700                                     floor_tick:
  985 4700    3A BE 48                04               ld a,(phase)
  986 4703    0F                      01               rrca
  987 4704    0F                      01               rrca
  988 4705    0F                      01               rrca
  989 4706    E6 0F                   02               and 15                    ; 16 Startpositionen in der wiederholten Farbliste
  990 4708    6F                      01               ld l,a
  991 4709    26 00                   02               ld h,0
  992 470B    11 24 49                03               ld de,floor_colors
  993 470E    19                      03               add hl,de
  994 470F    01 00 7F                03               ld bc,#7f00
  995 4712    1E 07                   02               ld e,7                    ; erster zu aendernder Pen
  996 4714    16 06                   02               ld d,6                    ; sechs Pens fuer die Bodenlinien
  997                                          ; Gemeinsame Palettenschleife, auch fuer die Initialisierung des Sees.
  998                                          ; E = erster Pen, D = Anzahl, HL = Farbcodes, BC = #7f00.
  999                                          ; Veraendert A, DE, HL und Flags; BC bleibt fuer beide OUTs gleich.
 1000 4716                                     floor_next:
 1001 4716    ED 59                   04               out (c),e
 1002 4718    7E                      02               ld a,(hl)
 1003 4719    ED 79                   04               out (c),a
 1004 471B    23                      02               inc hl
 1005 471C    1C                      01               inc e
 1006 471D    15                      01               dec d
 1007 471E    20 F6                   02               jr nz,floor_next
 1008 4720    C9                      03               ret
