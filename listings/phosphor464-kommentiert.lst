  295 413D    3E 10                   02               ld a,16
  296 413F    ED 79                   04               out (c),a
  297 4141    3E 54                   02               ld a,#54
  298 4143    ED 79                   04               out (c),a
  299 4145    3A BB 48                04               ld a,(scene)
  300 4148    87                      01               add a,a
