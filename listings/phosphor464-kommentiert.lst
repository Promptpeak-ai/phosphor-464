 1010                                          ; Hoehenfeld mit 64x64 Hoehen, 16 Tiefenstufen und 64 Bildspalten.
 1011                                          ; Jeder Block umfasst zwei Mode-0-Pixel und vier Rasterzeilen.
 1012                                          ; 64x32 logische Bloecke fuellen ein Fenster von 128x128 Mode-0-Pixeln.
 1013                                          ; 8 Spalten pro Videoframe: 8 Frames pro fertigem Landschaftsbild.
 1014                                          terrain_state equ #b800         ; 16 Paare aus Karten-/Projektionsadresse
 1015                                          ; LANDSCHAFT: acht Spalten je Videoframe in den unsichtbaren Bildspeicher.
 1016                                          ; Bei Spalte 0 bereitet terrain_prepare die Adressliste fuer diesen
 1017                                          ; Kamerastand vor. Diese Liste gilt fuer alle 64 Spalten desselben Bildes.
 1018                                          ; Nach Spalte 63 setzt R12 die Startadresse der fertigen Seite; die andere
 1019                                          ; Seite wird Arbeitsseite. Dann rueckt die Kamera eine Kartenzeile vor.
 1020                                          ; 64 Kamerastaende * 8 Frames ergeben die komplette 512-Frame-Szene.
 1021 4721                                     terrain_effect:
 1022 4721    3A CC 48                04               ld a,(terrain_column)
 1023 4724    B7                      01               or a
 1024 4725    CC 66 47                03               call z,terrain_prepare
 1025 4728    3E 08                   02               ld a,8
 1026 472A    32 D0 48                04               ld (terrain_batch),a
 1027 472D                                     terrain_batch_loop:
 1028 472D    CD B2 47                05               call terrain_draw_column
 1029 4730    3A CC 48                04               ld a,(terrain_column)
 1030 4733    3C                      01               inc a
 1031 4734    32 CC 48                04               ld (terrain_column),a
 1032 4737    3A D0 48                04               ld a,(terrain_batch)
 1033 473A    3D                      01               dec a
 1034 473B    32 D0 48                04               ld (terrain_batch),a
 1035 473E    20 ED                   02               jr nz,terrain_batch_loop
 1036 4740    3A CC 48                04               ld a,(terrain_column)
 1037 4743    FE 40                   02               cp 64
 1038 4745    C0                      02               ret nz
 1039 4746    AF                      01               xor a
 1040 4747    32 CC 48                04               ld (terrain_column),a
 1041 474A    3A C6 48                04               ld a,(back_page)
 1042 474D    0F                      01               rrca
 1043 474E    0F                      01               rrca
 1044 474F    1E 0C                   02               ld e,12
 1045 4751    CD EE 40                05               call crtc_write
 1046 4754    3A C6 48                04               ld a,(back_page)
 1047 4757    EE C0                   02               xor #c0
 1048 4759    32 C6 48                04               ld (back_page),a
 1049 475C    3A CD 48                04               ld a,(terrain_camera)
 1050 475F    3C                      01               inc a
 1051 4760    E6 3F                   02               and 63
 1052 4762    32 CD 48                04               ld (terrain_camera),a
 1053 4765    C9                      03               ret
 1054                                          
 1055                                          ; Nur einmal je Landschaftsbild. Adressstrom fuer POP DE vorbereiten.
 1056                                          ; ADRESSLISTE ERZEUGEN. terrain_camera ist die Welt-Zeile 0..63.
 1057                                          ; terrain_track[camera] liefert die seitliche Kameraposition terrain_x.
 1058                                          ; HL schreibt ab #b800, IY liest die 16 Tiefenabstaende, BC zeigt auf die
 1059                                          ; aktuelle Projektionszeile. Jeder Listeneintrag ist vier Bytes lang:
 1060                                          ; [Low(Kartenzeile), High(Kartenzeile), Low(Projektionszeile), High(...)]
 1061                                          ; POP DE wird spaeter genau diese Little-Endian-Woerter lesen.
 1062                                          ; Diese Vorbereitung benutzt noch den normalen Stack und darf CALL/RET nutzen.
 1063 4766                                     terrain_prepare:
 1064 4766    3A CD 48                04               ld a,(terrain_camera)
 1065 4769    5F                      01               ld e,a
 1066 476A    16 00                   02               ld d,0
 1067 476C    21 10 7C                03               ld hl,terrain_track
 1068 476F    19                      03               add hl,de
 1069 4770    7E                      02               ld a,(hl)
 1070 4771    32 CF 48                04               ld (terrain_x),a
 1071 4774    21 00 B8                03               ld hl,terrain_state
 1072 4777    FD 21 00 7C             04               ld iy,terrain_depths
 1073 477B    01 00 70                03               ld bc,terrain_projection
 1074 477E    3E 10                   02               ld a,16
 1075 4780    32 D1 48                04               ld (terrain_count),a
 1076                                          ; Weltzeile z = (camera + Tiefenabstand) AND 63.
 1077                                          ; Die Kartenadresse ist terrain_map + z*64. Fuer das Lowbyte genuegen
 1078                                          ; zwei RRCA und AND #c0: Nur die untersten zwei Bits von z landen oben.
 1079                                          ; Das Highbyte erhaelt z >> 2 plus das Highbyte der 256-Byte-ausgerichteten
 1080                                          ; Karte. Beispiel z=5: Offset #0140, Low=#40, High-Zuschlag=1.
 1081                                          ; Die Projektionszeile enthaelt 64 Hoehenwerte je Tiefe. BC waechst daher
 1082                                          ; um 64; bei Lowbyte-Ueberlauf erhoeht INC B explizit das Highbyte.
 1083 4783                                     terrain_prepare_depth:
 1084 4783    3A CD 48                04               ld a,(terrain_camera)
 1085 4786    FD 86 00                05               add a,(iy+0)
 1086 4789    E6 3F                   02               and 63
 1087 478B    5F                      01               ld e,a
 1088 478C    0F                      01               rrca
 1089 478D    0F                      01               rrca
 1090 478E    E6 C0                   02               and #c0
 1091 4790    77                      02               ld (hl),a
 1092 4791    23                      02               inc hl
 1093 4792    7B                      01               ld a,e
 1094 4793    CB 3F                   02               srl a
 1095 4795    CB 3F                   02               srl a
 1096 4797    C6 60                   02               add a,terrain_map/256
 1097 4799    77                      02               ld (hl),a
 1098 479A    23                      02               inc hl
 1099 479B    71                      02               ld (hl),c
 1100 479C    23                      02               inc hl
 1101 479D    70                      02               ld (hl),b
 1102 479E    23                      02               inc hl
 1103 479F    79                      01               ld a,c
 1104 47A0    C6 40                   02               add 64
 1105 47A2    4F                      01               ld c,a
 1106 47A3    30 01                   02               jr nc,terrain_projection_page
 1107 47A5    04                      01               inc b
 1108 47A6                                     terrain_projection_page:
 1109 47A6    FD 23                   03               inc iy
 1110 47A8    3A D1 48                04               ld a,(terrain_count)
 1111 47AB    3D                      01               dec a
