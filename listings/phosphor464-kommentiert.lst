 1301 485D    D6 08                   02               sub 8
 1302 485F    67                      01               ld h,a
 1303 4860    71                      02               ld (hl),c
 1304 4861    D6 08                   02               sub 8
 1305 4863    67                      01               ld h,a
 1306 4864    1D                      01               dec e
 1307 4865    20 0A                   02               jr nz,terrain_sky_row
 1308 4867    7D                      01               ld a,l
 1309 4868    D6 50                   02               sub 80
 1310 486A    6F                      01               ld l,a
 1311 486B    7C                      01               ld a,h
 1312 486C    DE C0                   02               sbc a,#c0
 1313 486E    67                      01               ld h,a
 1314 486F    1E 02                   02               ld e,2
 1315 4871                                     terrain_sky_row:
 1316 4871    10 E0                   04               djnz terrain_sky
 1317 4873    C9                      03               ret
 1318                                          
 1319                                          ; Der LZ48-Entpacker nutzt IXL als Token-Register. Das ist hier ein
 1320                                          ; konkreter Einsatz einer undokumentierten Z80-Indexhaelfte.
 1321                                          ; ENTPACKEN: Eingabe HL=komprimierte Quelle, DE=Ziel. Veraendert AF,
 1322                                          ; BC, DE, HL und IXL. IX als ganzer Zeiger ist danach ebenfalls veraendert.
 1323                                          ; Der Entpacker kopiert zuerst ein Literalbyte. Danach steuert ein Token
 1324                                          ; Literal-Laenge (oberes Halbbyte) und Wiederholungslaenge (unteres Halbbyte).
 1325                                          ; Zusatzbytes verlaengern diese Laengen; Matches haben mindestens 3 Bytes.
 1326                                          ; Ein Offsetbyte verweist auf schon erzeugte Zielbytes. Vorwaerts-LDIR
 1327                                          ; erlaubt dabei ueberlappende Kopien fuer wiederholte Muster.
 1328                                          ; Offsetbyte #ff wird durch INC A zu null und beendet den Strom per RET Z.
 1329                                          ; Der Entpacker speichert das Token in IXL, waehrend A Laengen berechnet.
 1330                                          ; Er liefert DE auf das Byte hinter der Ausgabe und HL auf das Endbyte
 1331                                          ; der Quelle. Die Aufrufer setzen ihre anderen Arbeitsregister danach neu.
 1332                                          ; Die Originaldatei bleibt eingebunden; unsere Erlaeuterung aendert sie nicht.
 1333                                                  include '../tools/rasm/decrunch/lz48decrunch_v006b.asm'
 1334                                          ; VERAENDERLICHER ZUSTAND. Bytewerte folgen als DB, Wortwerte als DW.
 1335                                          ; Tests erlauben Aenderungen genau bis mutable_end sowie an den beiden
 1336                                          ; Operandenbytes von restore_terrain_sp. Alle anderen Programmdaten
 1337                                          ; muessen waehrend der Show unveraendert bleiben.
 1338 48BA    0F                      01       volume_limit:   db 15             ; Obergrenze 0..15 fuer alle Musikpegel
 1339 48BB    00                      01       scene:          db 0              ; aktuelle Szene 0..6
 1340 48BC                                     scene_frame:    dw 0              ; Videoframes seit Szenenbeginn, 16 Bit
 1341 48BE    00                      01       phase:          db 0              ; globaler Animationszaehler, Umlauf nach 256
 1342 48BF    00                      01       finished:       db 0              ; 1 nach Schlussakkord und letztem Szenenframe
 1343 48C0    00                      01       beat_frame:     db 0              ; 0..7 innerhalb eines Notenschritts
 1344 48C1    00                      01       song_step:      db 0              ; 0..127 in der Notentabelle
 1345 48C2    00                      01       wave_index:     db 0              ; Sinusphase innerhalb des Spiegelungsfensters
 1346 48C3    00                      01       rows_left:      db 0              ; gemeinsamer Arbeitszaehler fuer Zeilenschleifen
 1347 48C4    00                      01       moire_row:      db 0              ; naechste Musterzeile 0..127
 1348 48C5    00                      01       moire_phase:    db 0              ; Verformungsphase; +3 je fertigem Musterbild
 1349 48C6    00                      01       back_page:      db 0              ; Highbyte der unsichtbaren Seite: #00 oder #c0
 1350 48C7                                     scroll_pos:     dw 0              ; Byteoffset der naechsten Sieben-Byte-Schriftspalte
 1351 48C9                                     scene_length:   dw 0              ; Sollzahl der Frames fuer die aktuelle Szene
 1352 48CB    00                      01       road_phase:     db 0              ; Fahrbahnphase 0..31
 1353 48CC    00                      01       terrain_column: db 0              ; naechste Spalte 0..63 auf der Arbeitsseite
 1354 48CD    00                      01       terrain_camera: db 0              ; Kamera-Z / Tabellenphase 0..63
 1355 48CE    00                      01       terrain_top:    db 0              ; erste bereits gefuellte Zeile, relativ zum Fenster
 1356 48CF    00                      01       terrain_x:      db 0              ; seitliche Kameraposition aus terrain_track
 1357 48D0    00                      01       terrain_batch:  db 0              ; noch zu zeichnende Spalten dieses Frames, anfangs 8
 1358 48D1    00                      01       terrain_count:  db 0              ; Tiefenpunkte bei der Adressvorbereitung, anfangs 16
 1359                                          ; Ab hier folgen unveraenderliche Tabellen. Die Szenenlaengen ergeben
 1360                                          ; zusammen 3072 Videoframes; Entpackpausen kommen zur Showdauer hinzu.
 1361 48D2                                     mutable_end:
 1362 48D6    4F 4B                   06       lake_colors:    db #44,#58,#5d,#4d,#4f,#4b
 1363 48D8                                     scene_lengths:  dw 384,384,512,512,128,512,640
 1364 48F2    5D 5B 4F 4B             16       terrain_palette: db #54,#44,#55,#46,#56,#5a,#59,#52,#5e,#43,#4b,#58,#5d,#5b,#4f,#4b
 1365 48FA    4D 4D 4D 4D             08       road_colors:    db #4b,#4b,#4b,#4b,#4d,#4d,#4d,#4d
 1366 4902    4D 4D 4D 4D             08                       db #4b,#4b,#4b,#4b,#4d,#4d,#4d,#4d
 1367                                          ; CRTC-REGISTERWERTE IN REIHENFOLGE R0..R13:
 1368                                          ; R0=63: 64 Zeichenzeiten je Zeile; R1=40: 40 sichtbar (=80 Bytes).
 1369                                          ; R2=46: horizontale Syncposition; R3=#8e: Syncbreiten, CRTC-abhaengige Wirkung.
 1370                                          ; R4=38: 39 Zeichenzeilen gesamt; R5=0: keine zusaetzlichen Rasterzeilen.
 1371                                          ; R6=0: anfangs unsichtbar; R7=30: vertikale Syncposition.
 1372                                          ; R8=0: regulare progressive Darstellung ohne Interlace/Skew.
 1373                                          ; R9=7: acht Rasterzeilen je Zeichenzeile; 39*8 ergibt 312 Gesamtzeilen.
 1374                                          ; R10/R11=0: Cursorparameter, fuer diese Bitmapdarstellung ohne Nutzen.
 1375                                          ; R12=#30, R13=0: Bildstart auf CPU-RAM-Seite #c000.
 1376 4912    30 00                   14       crtc_defaults:  db 63,40,46,142,38,0,0,30,0,7,0,0,48,0
 1377 4914                                     initial_palette: incbin '../assets/palette.bin'
 1378 4928    4B 4F 5D 58             08       floor_colors:   db #44,#58,#5d,#4f,#4b,#4f,#5d,#58
 1379 4930    4B 4F 5D 58             08                       db #44,#58,#5d,#4f,#4b,#4f,#5d,#58
 1380 4938    4B 4F 5D 58             08                       db #44,#58,#5d,#4f,#4b,#4f,#5d,#58
 1381 493C                                     lead_notes:     incbin '../assets/lead.bin'
 1382 4A3C                                     bass_notes:     incbin '../assets/bass.bin'
 1383                                          ; 224 Zeilenoffsets als Little-Endian-Woerter. Die gemeinsame Formel
 1384                                          ; steht im Dateikopf. Die Seite wird erst beim Zeichnen per OR ergaenzt.
 1385                                          ; Die zusaetzlichen 24 Eintraege ueber 200 hinaus bleiben hier unbenutzt.
 1386 4B3C                                     row_addresses:  incbin '../assets/rows.bin'
 1387 4CFC                                     pictures:       dw picture,lake_picture,drive_picture,terrain_picture,split_picture,phase_picture,finale_picture
 1388                                                  include '../assets/sizes.asm'
 1389                                                  align 256
 1390                                          ; ALIGN 256 davor richtet light_table auf eine volle Seite aus.
 1391                                          ; light_table und sine_table belegen je 256 Bytes. Deshalb liegen auch
 1392                                          ; moire_patterns und die folgenden ganzen Tabellen auf Seitengrenzen.
 1393                                          ; LD H,Tabelle/256 plus LD L,Index ersetzt eine 16-Bit-Addition.
 1394 4E00                                     light_table:    incbin '../assets/light.bin'
 1395 4F00                                     sine_table:     incbin '../assets/sine.bin'
 1396 5000                                     moire_patterns: incbin '../assets/moire.bin'
 1397                                          ; Statische Geometrie- und Projektionstabellen; keine Videoframes.
 1398                                          ; GEOMETRIEDATEN. Karte: 64*64 Hoehenbytes; Projektion/Farbe: je 16*64.
 1399                                          ; X-Abtastung: 64 Spalten * 16 Tiefen = 1024 Bytes, signed Abstaende modulo 64.
 1400                                          ; Farbtabelle und Projektion muessen exakt 1024 Bytes auseinanderliegen,
 1401                                          ; weil terrain_sample allein D um 4 erhoeht. ASSERTs unten pruefen das.
 1402 6000                                     terrain_map:    incbin '../assets/terrain-map.bin'
 1403 7000                                     terrain_projection: incbin '../assets/terrain-projection.bin'
 1404 7400                                     terrain_colours: incbin '../assets/terrain-colours.bin'
 1405 7800                                     terrain_samples: incbin '../assets/terrain-samples.bin'
 1406 7C00                                     terrain_depths: incbin '../assets/terrain-depths.bin'
 1407 7C10                                     terrain_track:  incbin '../assets/terrain-track.bin'
 1408                                          ; KOMPRIMIERTE SZENENDATEN. INCL48 ist eine Assemblerfunktion:
 1409                                          ; RASM liest die Datei und legt ihren LZ48-Strom im Programm ab.
 1410                                          ; LZ48_decrunch expandiert diesen Strom erst auf dem CPC. Die *.rle-Dateien
 1411                                          ; des Grafikgenerators gehoeren nicht zu diesem Ladepfad.
 1412                                          ; Sieben Motive entpacken jeweils nach #c000; road/water/scroll nach #0000.
 1413 7C50                                     picture:        incl48 '../assets/title.scr'
 1414 864E                                     lake_picture:   incl48 '../assets/lake.scr'
 1415 8C14                                     drive_picture:  incl48 '../assets/drive.scr'
 1416 9306                                     terrain_picture: incl48 '../assets/terrain.scr'
 1417 94C2                                     split_picture:  incl48 '../assets/split.scr'
 1418 9BDD                                     phase_picture:  incl48 '../assets/phase.scr'
 1419 9F55                                     finale_picture: incl48 '../assets/finale.scr'
 1420 A94D                                     road_packed:    incl48 '../assets/road.bin'
 1421 AD3D                                     water_packed:   incl48 '../assets/water.bin'
 1422 AEEF                                     scroll_packed:  incl48 '../assets/scroll.bin'
 1423                                          ; ENDE EXKLUSIV. Die Laenge ist program_end-start; hier folgt kein Datenbyte.
 1424                                          ; Die ASSERTs brechen den Build ab, falls Code in die Adressliste reicht
 1425                                          ; oder eine schnelle Tabellenadressierung ihre Ausrichtungsannahme verliert.
 1426                                          ; SAVE erzeugt dieselben Nutzbytes als BIN sowie in CPC-Bandbloecken im CDT.
 1427                                          ; RUN #4000 legt die Startadresse fuer das erzeugte Programm fest.
 1428 B08D                                     program_end:
 1429                                                  assert program_end < #b800
 1430                                                  assert (terrain_map & 255) == 0
 1431                                                  assert (terrain_projection & 255) == 0
 1432                                                  assert terrain_colours-terrain_projection == 1024
 1433                                                  assert terrain_samples-terrain_colours == 1024
 1434                                                  save '../build/phosphor464.bin',start,program_end-start
 1435                                                  save 'PHOSPHOR.BIN',start,program_end-start,TAPE,'../build/phosphor464.cdt'

ANHANG: LZ48-Entpacker von Edouard Berge
Registervertrag und Algorithmus stehen am INCLUDE im Hauptquelltext.
Originaldatei: tools/rasm/decrunch/lz48decrunch_v006b.asm

    1 ;
    2 ; LZ48 decrunch
    3 ;
    4 
    5 ; In	; HL=compressed data address
    6 ; 	; DE=output data address
    7 ; Out	; HL    last address of compressed data read (you must inc once for LZ48 stream)
    8 ;	; DE    last address of decrunched data write +1
    9 ;	; BC    always 3
   10 ;	; A     always zero
   11 ;	; IXL   undetermined
   12 ;	; flags (inc a -> 0)
   13 ; Modif	; AF, BC, DE, HL, IXL
   14 LZ48_decrunch
   15 	ldi
   16 	ld b,0
   17 
   18 nextsequence
   19 	ld a,(hl)
   20 	inc hl
   21 	cp #10
   22 	jr c,lzunpack ; no literal bytes
   23 	ld ixl,a
   24 	and #f0
   25 	rrca
   26 	rrca
   27 	rrca
   28 	rrca
   29 
   30 	cp 15 ; more bytes for literal length?
   31 	jr nz,copyliteral
   32 getadditionallength
   33 	ld c,(hl) ; get additional literal length byte
   34 	inc hl
   35 	add a,c ; compute literal length total
   36 	jr nc,lengthNC
   37 	inc b
   38 lengthNC
   39 	inc c
   40 	jr z,getadditionallength ; if last literal length byte was 255, we have more bytes to process
   41 copyliteral
   42 	ld c,a
   43 	ldir
   44 	ld a,ixl
   45 	and #F
   46 lzunpack
   47 	add 3
   48 	cp 18 ; more bytes for match length?
   49 	jr nz,readoffset
   50 getadditionallengthbis
   51 	ld c,(hl) ; get additional match length byte
   52 	inc hl
   53 	add a,c ; compute match length size total
   54 	jr nc,lengthNCbis
   55 	inc b
   56 lengthNCbis
   57 	inc c
   58 	jr z,getadditionallengthbis ; if last match length byte was 255, we have more bytes to process
   59 
   60 readoffset
   61 	ld c,a
   62 ; read encoded offset
   63 	ld a,(hl)
   64 	inc a
   65 	ret z ; LZ48 end with zero offset
   66 	inc hl
   67 	push hl
   68 ; source=dest-copyoffset
   69 	; A != 0 here
   70 	neg
   71 	ld l,a
   72 	ld h,#ff
   73 	add hl,de
   74 copykey
   75 	ldir
   76 
   77 	pop hl
   78 	jr nextsequence
