  553                                          ; Feste Kamera. Nur acht Pixel der Mittellinie pro Zeile werden kopiert.
  554                                          ; 32 Perspektivphasen, zuerst alle zwei Frames, dann jeder Frame. R13 bleibt null.
  555                                          ; STRASSENBEWEGUNG. Die Bildschirmadresse bleibt konstant (R13=0).
  556                                          ; Solange das Highbyte von scene_frame null ist, teilt SRL A die Zeit durch 2.
  557                                          ; Ab Frame 256 gibt jeder Videoframe die naechste der 32 Phasen frei.
  558                                          ; AND 31 bildet den zyklischen Phasenindex; die Tabelle liegt ab Adresse 0.
  559                                          ; Der Z80 besitzt keine Multiplikation. Sechs ADD HL,HL bilden phase*64;
  560                                          ; DE merkt sich diesen Wert, zwei weitere Verdopplungen ergeben phase*256.
  561                                          ; ADD HL,DE liefert phase*320, den Beginn von 80 Zeilen zu je vier Bytes.
  562 4392                                     road_effect:
  563 4392    3A BD 48                04               ld a,(scene_frame+1)      ; Highbyte: ab Frame 256 ungleich null
  564 4395    B7                      01               or a                      ; Zero-Flag merkt sich die langsame/schnelle Phase
  565 4396    3A BC 48                04               ld a,(scene_frame)        ; Lowbyte laden, ohne das Zero-Flag zu veraendern
  566 4399    20 02                   02               jr nz,road_fast           ; ab Frame 256 die Halbierung ueberspringen
  567 439B    CB 3F                   02               srl a                   ; die ersten fuenf Sekunden langsamer
  568 439D                                     road_fast:
  569 439D    E6 1F                   02               and 31
  570 439F    32 CB 48                04               ld (road_phase),a
  571 43A2    6F                      01               ld l,a
  572 43A3    26 00                   02               ld h,0
  573 43A5    29                      03               add hl,hl
  574 43A6    29                      03               add hl,hl
  575 43A7    29                      03               add hl,hl
  576 43A8    29                      03               add hl,hl
  577 43A9    29                      03               add hl,hl
  578 43AA    29                      03               add hl,hl               ; phase*64
  579 43AB    54                      01               ld d,h
  580 43AC    5D                      01               ld e,l
  581 43AD    29                      03               add hl,hl
  582 43AE    29                      03               add hl,hl
  583 43AF    19                      03               add hl,de               ; phase*320
  584 43B0    DD 21 2C 4C             04               ld ix,row_addresses+120*2
  585 43B4    3E 50                   02               ld a,80
  586 43B6    32 C3 48                04               ld (rows_left),a
  587                                          ; IX liest die Zielzeile 120..199 aus row_addresses. Der Zusatz 38
  588                                          ; waehlt die Byte-Spalten 38..41, also Mode-0-Pixel 76..83 in der Bildmitte.
  589                                          ; PUSH/POP bewahrt HL als Quellzeiger waehrend der Zieladressrechnung.
  590                                          ; Vier LDI schreiben genau diese acht Pixel. 80 Zeilen brauchen 320 Bytes;
  591                                          ; die uebrige Grafik bleibt unangetastet. Danach folgen passende Randfarben.
  592 43B9                                     road_row:
  593 43B9    DD 5E 00                05               ld e,(ix+0)
  594 43BC    DD 7E 01                05               ld a,(ix+1)
  595 43BF    F6 C0                   02               or #c0
  596 43C1    57                      01               ld d,a
  597 43C2    E5                      04               push hl
  598 43C3    21 26 00                03               ld hl,38
  599 43C6    19                      03               add hl,de
  600 43C7    EB                      01               ex de,hl
  601 43C8    E1                      03               pop hl
  602                                                  repeat 4
  603 43C9    ED A0 ED A0 ED A0 ...   05 x4            ldi
  604                                                  rend
  605 43D1    DD 23                   03               inc ix
  606 43D3    DD 23                   03               inc ix
  607 43D5    3A C3 48                04               ld a,(rows_left)
  608 43D8    3D                      01               dec a
  609 43D9    32 C3 48                04               ld (rows_left),a
  610 43DC    20 DB                   02               jr nz,road_row
  611                                                  ; Passende Bewegungsphase fuer die acht Bordsteinfarben.
  612 43DE    3A CB 48                04               ld a,(road_phase)
  613 43E1    CB 3F                   02               srl a
  614 43E3    CB 3F                   02               srl a
  615 43E5    6F                      01               ld l,a
  616 43E6    26 00                   02               ld h,0
  617 43E8    11 F6 48                03               ld de,road_colors
  618 43EB    19                      03               add hl,de
  619 43EC    01 00 7F                03               ld bc,#7f00
  620 43EF    1E 07                   02               ld e,7
  621 43F1    16 08                   02               ld d,8
  622                                          ; E=7..14 sind acht vorbereitete Farbklassen an den Bordsteinen.
  623                                          ; HL liest acht Werte aus road_colors, beginnend bei floor(road_phase/4).
  624                                          ; Die Tabelle enthaelt zwei gleiche Achtergruppen, damit dieser Ausschnitt
  625                                          ; ohne Sonderfall ueber das Ende der ersten Gruppe laufen darf.
  626                                          ; Farbrotation bewegt so die Bordsteine ohne Kopieren ihrer Pixel.
  627 43F3                                     road_palette:
  628 43F3    ED 59                   04               out (c),e
