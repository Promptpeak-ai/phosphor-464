  494                                          ; Spiegelung: 32 unabhaengig verschobene Zeilen, jeweils 80 Bytes.
  495                                          ; Entrolltes LDI spart gegenueber wiederholendem LDIR 1 us pro Byte.
  496                                          ; WASSERSPIEGELUNG. IX zeigt auf 16-Bit-Zeilenoffsets ab Bildschirmzeile 128.
  497                                          ; IY zeigt auf die naechste 96-Byte-Quellzeile im unteren RAM. Jede besteht
  498                                          ; aus 8 Randbytes, 80 Bildbytes und nochmals 8 Randbytes zum Verschieben.
  499                                          ; Der Sinuswert 1..95, viermal rechtsgeschoben, ergibt 0..5; plus 5 also
  500                                          ; Quellversatz 5..10. Der Ausschnitt bleibt stets innerhalb der 96 Bytes.
  501                                          ; 32 Zeilen * 80 LDI * 5 us ergeben 12,8 ms reine Kopierzeit pro Frame.
  502                                          ; Die entrollten LDIs sparen den Wiederholungszuschlag von LDIR.
  503                                          ; BC wird dabei dekrementiert, dient hier aber nicht als Schleifenzaehler.
  504 42A2                                     water_effect:
  505 42A2    DD 21 3C 4C             04               ld ix,row_addresses+128*2
  506 42A6    FD 21 00 00             04               ld iy,0
  507 42AA    3A BE 48                04               ld a,(phase)
  508 42AD    32 C2 48                04               ld (wave_index),a
  509 42B0    3E 20                   02               ld a,32
  510 42B2    32 C3 48                04               ld (rows_left),a
  511                                          ; HL = IY + horizontaler Quellversatz. PUSH IY / POP HL kopiert den
  512                                          ; Indexregisterwert in HL; danach steht der normale Stack wieder wie zuvor.
  513                                          ; DE = #c000 OR Zeilenoffset aus (IX). Da der Offset kleiner als #4000 ist,
  514                                          ; ueberlappen seine Bits nicht mit der Seitenbasis; OR entspricht Addition.
  515                                          ; 80 LDI lesen fortlaufend von HL und schreiben fortlaufend nach DE.
  516                                          ; IX += 2 geht zur naechsten Bildschirmzeile, IY += 96 zur naechsten Quelle.
  517                                          ; wave_index += 3 veraendert die Wellenphase zwischen benachbarten Zeilen.
  518 42B5                                     water_row:
  519 42B5    3A C2 48                04               ld a,(wave_index)
  520 42B8    6F                      01               ld l,a
  521 42B9    26 4F                   02               ld h,sine_table/256
  522 42BB    7E                      02               ld a,(hl)
  523 42BC    CB 3F                   02               srl a                     ; Wellenwert halbieren; vier SRL ergeben Division durch 16
  524 42BE    CB 3F                   02               srl a                     ; Wellenwert halbieren; vier SRL ergeben Division durch 16
  525 42C0    CB 3F                   02               srl a                     ; Wellenwert halbieren; vier SRL ergeben Division durch 16
  526 42C2    CB 3F                   02               srl a                     ; Wellenwert halbieren; vier SRL ergeben Division durch 16
  527 42C4    C6 05                   02               add 5                     ; Ausschnittbeginn im gepolsterten Quellstreifen
  528 42C6    5F                      01               ld e,a
  529 42C7    16 00                   02               ld d,0
  530 42C9    FD E5                   05               push iy
  531 42CB    E1                      03               pop hl
  532 42CC    19                      03               add hl,de
  533 42CD    DD 5E 00                05               ld e,(ix+0)
  534 42D0    DD 7E 01                05               ld a,(ix+1)
  535 42D3    F6 C0                   02               or #c0
  536 42D5    57                      01               ld d,a
  537                                                  repeat 80
  538 42D6    ED A0 ED A0 ED A0 ...   05 x80           ldi
  539                                                  rend
  540 4376    11 60 00                03               ld de,96                  ; Schrittweite einer gepolsterten Wasserzeile
  541 4379    FD 19                   04               add iy,de                 ; Quelle der naechsten Spiegelungszeile
  542 437B    DD 23                   03               inc ix
  543 437D    DD 23                   03               inc ix
  544 437F    3A C2 48                04               ld a,(wave_index)
  545 4382    C6 03                   02               add 3
  546 4384    32 C2 48                04               ld (wave_index),a
  547 4387    3A C3 48                04               ld a,(rows_left)
  548 438A    3D                      01               dec a
  549 438B    32 C3 48                04               ld (rows_left),a
  550 438E    C2 B5 42                03               jp nz,water_row
  551 4391    C9                      03               ret
