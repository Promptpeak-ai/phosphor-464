  429 4223    B7                      01               or a
  430 4224    3E 19                   02               ld a,25
  431 4226    20 0A                   02               jr nz,shutter_write
  432 4228    7D                      01               ld a,l
  433 4229    FE 0D                   02               cp 13
  434 422B    38 04                   02               jr c,shutter_double
  435 422D    3E 19                   02               ld a,25
  436 422F    18 01                   03               jr shutter_write
  437 4231                                     shutter_double:
  438 4231    87                      01               add a,a
  439 4232                                     shutter_write:
  440 4232    1E 06                   02               ld e,6
  441 4234    C3 EE 40                03               jp crtc_write
