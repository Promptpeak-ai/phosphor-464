  637                                          ; Mode 2: 640x200, zwei Farben. 32 neue Zeilen je Videoframe,
  638                                          ; 128 Zeilen je Musterbild. CRTC-Seitenwechsel erst nach fertigem Bild.
  639                                          ; Tabelle enthaelt acht Pixelphasen einer nichtlinearen Linienstruktur.
  640                                          ; MODE-2-INTERFERENZ. Veraendert AF, BC, DE und HL sowie die Arbeitsbytes.
  641                                          ; 32 Zeilen je Aufruf, 128 Zeilen je fertigem Muster: Umschaltung alle 4 Frames.
  642                                          ; moire_row ist die Zeile 0..127 innerhalb des Fensters, Bildschirm-y ist +36.
  643                                          ; back_page ist das Highbyte der unsichtbaren Seite (#00 oder #c0).
  644                                          ; Die Schriftbereiche ausserhalb des Fensters bleiben in beiden Seiten gleich.
  645 43FE                                     moire_effect:
  646 43FE    3E 20                   02               ld a,32
  647 4400    32 C3 48                04               ld (rows_left),a
  648                                          ; Zieladresse zuerst bestimmen, dann auf dem Stack sichern.
  649                                          ; Der Index 2*(moire_row+36) kann 255 ueberschreiten. ADD A,A liefert das
  650                                          ; neunte Bit in Carry. LD L,A und LD H,0 erhalten Carry; INC H setzt es
  651                                          ; bei Bedarf als Highbyte des Tabellenoffsets um.
  652 4403                                     moire_row_loop:
  653 4403    3A C4 48                04               ld a,(moire_row)
  654 4406    C6 24                   02               add 36                    ; Fenster beginnt in Bildschirmzeile 36
  655 4408    87                      01               add a,a                   ; Wortindex; Carry traegt das neunte Adressbit
  656 4409    6F                      01               ld l,a
  657 440A    26 00                   02               ld h,0                    ; LD veraendert Carry nicht
  658 440C    30 01                   02               jr nc,moire_addr          ; ohne Ueberlauf passt der Index ins Lowbyte
  659 440E    24                      01               inc h                     ; sonst Highbyte des Tabellenoffsets auf 1 setzen
  660                                          ; row_addresses liefert den Offset; OR back_page ergaenzt dessen Seite.
  661                                          ; Der Sinusindex lautet (2*moire_row + moire_phase) modulo 256.
  662                                          ; Die Amplitude waechst zeitlich: Frames 0..127 Viertelwert, 128..255
  663                                          ; Halbwert, danach voller Wert. Das macht die Verformung allmaehlich staerker.
  664 440F                                     moire_addr:
  665 440F    11 3C 4B                03               ld de,row_addresses
  666 4412    19                      03               add hl,de
  667 4413    5E                      02               ld e,(hl)
  668 4414    23                      02               inc hl
  669 4415    3A C6 48                04               ld a,(back_page)
  670 4418    B6                      02               or (hl)
  671 4419    57                      01               ld d,a
  672 441A    D5                      04               push de
  673 441B    3A C4 48                04               ld a,(moire_row)
  674 441E    87                      01               add a,a
  675 441F    47                      01               ld b,a
  676 4420    3A C5 48                04               ld a,(moire_phase)
  677 4423    80                      01               add a,b
  678 4424    6F                      01               ld l,a
  679 4425    26 4F                   02               ld h,sine_table/256
  680 4427    7E                      02               ld a,(hl)
  681 4428    47                      01               ld b,a
  682 4429    3A BD 48                04               ld a,(scene_frame+1)
  683 442C    B7                      01               or a
  684 442D    78                      01               ld a,b
  685 442E    20 0D                   02               jr nz,moire_amplitude
  686 4430    CB 3F                   02               srl a
  687 4432    47                      01               ld b,a
  688 4433    3A BC 48                04               ld a,(scene_frame)
  689 4436    CB 7F                   02               bit 7,a
  690 4438    78                      01               ld a,b
  691 4439    20 02                   02               jr nz,moire_amplitude
  692 443B    CB 3F                   02               srl a
  693                                          ; Der Wert B steuert Feinauswahl und Byteversatz. Seine unteren drei Bits
  694                                          ; waehlen eine von acht Pixelphasen. Jede Variante belegt 512 Bytes:
  695                                          ; 256 Musterbytes und eine identische zweite Haelfte fuer randlose Ausschnitte.
  696                                          ; (Phase AND 7)*2 addiert die passende Zahl von 256-Byte-Seiten zu H.
  697                                          ; L=(moire_row+B) modulo 256 waehlt den Anfang innerhalb der Variante.
  698                                          ; Ein 80-Byte-LDI-Ausschnitt passt dank der doppelten Ablage auch ab Offset 255.
  699                                          ; Erst nach Zeile 127 schreibt R12 die fertige Seite. RRCA zweimal bildet
  700                                          ; #c0 -> #30 bzw. #00 -> #00. XOR #c0 wechselt danach die Arbeitsseite.
  701 443D                                     moire_amplitude:
  702 443D    47                      01               ld b,a
  703 443E    E6 07                   02               and 7
  704 4440    87                      01               add a,a
  705 4441    C6 50                   02               add a,moire_patterns/256
  706 4443    67                      01               ld h,a
  707 4444    3A C4 48                04               ld a,(moire_row)
  708 4447    80                      01               add a,b
  709 4448    6F                      01               ld l,a
  710 4449    D1                      03               pop de
  711                                                  repeat 80
  712 444A    ED A0 ED A0 ED A0 ...   05 x80           ldi
  713                                                  rend
  714 44EA    3A C4 48                04               ld a,(moire_row)
  715 44ED    3C                      01               inc a
