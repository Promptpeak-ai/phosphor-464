  630 43F6    ED 79                   04               out (c),a
  631 43F8    23                      02               inc hl
  632 43F9    1C                      01               inc e
  633 43FA    15                      01               dec d
  634 43FB    20 F6                   02               jr nz,road_palette
  635 43FD    C9                      03               ret
