  443                                          ; Die letzten 32 Zeilen bleiben fuer Laufschrift in stabiler Farbe.
  444                                          ; Eintritt nach VSYNC; Pollphase kann wenige Mikrosekunden schwanken.
  445                                          ; CHROM UND SPLIT: Nur Pen 1 wechselt seine Farbe, die Pixelbytes bleiben.
  446                                          ; Die Warteschleife verschiebt den Start vom VSYNC in den sichtbaren Bereich.
  447                                          ; 640 Durchlaeufe kosten ungefaehr 4,48 ms auf dem CPC.
  448                                          ; light_table liegt auf einer 256-Byte-Grenze: H bleibt konstant, L ist
  449                                          ; phase. INC L laeuft nach 255 auf 0, ohne in die naechste Tabelle zu tragen.
  450                                          ; D zaehlt 168 Farbzeilen; in Szene 4 sind es 144 bis zum Mode-2-Unterteil.
  451 4237                                     raster_effect:
  452 4237    11 80 02                03               ld de,640
  453 423A                                     top_delay:
  454 423A    1B                      02               dec de
  455 423B    7A                      01               ld a,d
  456 423C    B3                      01               or e
  457 423D    20 FB                   02               jr nz,top_delay
  458 423F    01 00 7F                03               ld bc,#7f00
  459 4242    3E 01                   02               ld a,1
  460 4244    ED 79                   04               out (c),a
  461 4246    3A BE 48                04               ld a,(phase)
  462 4249    6F                      01               ld l,a
  463 424A    26 4E                   02               ld h,light_table/256
  464 424C    3A BB 48                04               ld a,(scene)
  465 424F    FE 04                   02               cp 4
  466 4251    16 A8                   02               ld d,168
  467 4253    20 02                   02               jr nz,raster_line
  468 4255    16 90                   02               ld d,144
  469                                          ; ZEITKRITISCH: Zwischen zwei aufeinanderfolgenden Farb-OUTs liegen
  470                                          ; bei genommenem JR genau 64 us im CPC-Timing:
  471                                          ; LD A,(HL) 2 + OUT 4 + INC L 1 + 53*NOP 53 + DEC D 1 + JR NZ 3.
  472                                          ; DEFS 53,0 legt 53 Opcodebytes #00 ab: Die CPU fuehrt sie als NOP aus.
  473                                          ; Ein hinzugefuegter Befehl verschiebt alle folgenden Farbwechsel.
  474                                          ; Der letzte JR faellt durch; danach setzt #4b den Pen auf helles Weiss.
  475                                          ; Szene 4 schreibt anschliessend #8e: Das Gate Array interpretiert die
  476                                          ; folgenden Bildschirmbytes als acht 1-Bit-Pixel statt zwei 4-Bit-Pixel.
  477                                          ; Der Generator hat den unteren Bildbereich bereits passend gepackt.
  478 4257                                     raster_line:
  479 4257    7E                      02               ld a,(hl)                 ; 2 us: naechste Lichtfarbe lesen
  480 4258    ED 79                   04               out (c),a                 ; 4 us: Farbwechsel fuer den bereits gewaehlten Pen 1
  481 425A    2C                      01               inc l                     ; 1 us: Tabellenindex mit 8-Bit-Umlauf
  482 428F    00                      53               defs 53,0                 ; 53 us: 53 ausgefuehrte NOPs (#00)
  483 4290    15                      01               dec d                     ; 1 us: verbleibende Farbzeilen zaehlen
  484 4291    20 C4                   02               jr nz,raster_line        ; exakt 64 us zwischen den OUTs
  485 4293    3E 4B                   02               ld a,#4b
  486 4295    ED 79                   04               out (c),a                 ; 4 us: Farbwechsel fuer den bereits gewaehlten Pen 1
  487 4297    3A BB 48                04               ld a,(scene)
  488 429A    FE 04                   02               cp 4
  489 429C    C0                      02               ret nz
  490 429D    3E 8E                   02               ld a,#8e
  491 429F    ED 79                   04               out (c),a               ; mitten im Bild: Mode 0 -> Mode 2
  492 42A1    C9                      03               ret
