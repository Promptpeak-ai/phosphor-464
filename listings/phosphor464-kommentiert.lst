  717 44F1    3A C3 48                04               ld a,(rows_left)
  718 44F4    3D                      01               dec a
  719 44F5    32 C3 48                04               ld (rows_left),a
  720 44F8    C2 03 44                03               jp nz,moire_row_loop
  721 44FB    3A C4 48                04               ld a,(moire_row)
  722 44FE    FE 80                   02               cp 128
  723 4500    C0                      02               ret nz
  724 4501    AF                      01               xor a
  725 4502    32 C4 48                04               ld (moire_row),a
  726 4505    3A C6 48                04               ld a,(back_page)
  727 4508    0F                      01               rrca
  728 4509    0F                      01               rrca
  729 450A    1E 0C                   02               ld e,12
  730 450C    CD EE 40                05               call crtc_write
  731 450F    3A C6 48                04               ld a,(back_page)
  732 4512    EE C0                   02               xor #c0
  733 4514    32 C6 48                04               ld (back_page),a
  734 4517    3A C5 48                04               ld a,(moire_phase)
