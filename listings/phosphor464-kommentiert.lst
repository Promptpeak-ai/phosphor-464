 1293 4853    71                      02               ld (hl),c
 1294 4854    7C                      01               ld a,h
 1295 4855    D6 08                   02               sub 8
 1296 4857    67                      01               ld h,a
 1297 4858    71                      02               ld (hl),c
 1298 4859    D6 08                   02               sub 8
 1299 485B    67                      01               ld h,a
