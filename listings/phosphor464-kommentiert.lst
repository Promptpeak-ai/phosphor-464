  739                                          ; Eine breite Pixelschrift bewegt sich um zwei Mode-0-Pixel pro Bild.
  740                                          ; Ihr entpackter Spaltenstrom liegt nur im Finale bei &0000.
  741                                          ; LAUFSCHRIFT IM FINALE. scroll_pos ist ein Byteoffset in der Quelle.
  742                                          ; Der Strom speichert pro horizontaler Schriftspalte sieben Bytes,
  743                                          ; eines fuer jede der sieben Pixelzeilen. Ein Byte enthaelt zwei gleiche
  744                                          ; Mode-0-Pixel. Pro Frame wandert die Schrift deshalb zwei Pixel nach links.
  745                                          ; Bei scroll_pos >= scroll_size endet die Routine sofort. Der Generator
  746                                          ; haengt Leerzeichen an; am Ende ist der gesamte Scrollstreifen leer.
  747 4520                                     scroll_tick:
  748 4520    2A C7 48                05               ld hl,(scroll_pos)
  749 4523    11 18 0F                03               ld de,scroll_size
  750 4526    B7                      01               or a
  751 4527    ED 52                   04               sbc hl,de
  752 4529    D0                      02               ret nc
  753 452A    DD 21 9C 4C             04               ld ix,row_addresses+176*2
  754 452E    FD 2A C7 48             06               ld iy,(scroll_pos)
  755 4532    3E 07                   02               ld a,7
  756 4534    32 C3 48                04               ld (rows_left),a
  757                                          ; DE zeigt auf Byte 0 der Zielzeile, HL auf Byte 1 derselben Zeile.
  758                                          ; 79 LDI schieben die Zeile um ein Byte nach links. Die Kopierrichtung ist
  759                                          ; sicher: Die Quelle liegt immer ein Byte vor dem Ziel, kein spaeter noch
  760                                          ; benoetigtes Quellbyte wird ueberschrieben. DE endet auf dem rechten Rand.
  761                                          ; Dorthin kommt (IY), das naechste Byte dieser Schriftspalte. IY waechst
  762                                          ; pro Pixelzeile um eins; scroll_pos waechst erst nach sieben Zeilen um 7.
  763 4537                                     scroll_row:
  764 4537    DD 5E 00                05               ld e,(ix+0)
  765 453A    DD 7E 01                05               ld a,(ix+1)
  766 453D    F6 C0                   02               or #c0
  767 453F    57                      01               ld d,a
  768 4540    62                      01               ld h,d
  769 4541    6B                      01               ld l,e
  770 4542    23                      02               inc hl
  771                                                  repeat 79
  772 4543    ED A0 ED A0 ED A0 ...   05 x79           ldi
  773                                                  rend
  774 45E1    FD 7E 00                05               ld a,(iy+0)
  775 45E4    12                      02               ld (de),a
  776 45E5    FD 23                   03               inc iy
  777 45E7    DD 23                   03               inc ix
  778 45E9    DD 23                   03               inc ix
  779 45EB    3A C3 48                04               ld a,(rows_left)
  780 45EE    3D                      01               dec a
  781 45EF    32 C3 48                04               ld (rows_left),a
  782 45F2    C2 37 45                03               jp nz,scroll_row
  783 45F5    2A C7 48                05               ld hl,(scroll_pos)
  784 45F8    11 07 00                03               ld de,7
  785 45FB    19                      03               add hl,de
  786 45FC    22 C7 48                05               ld (scroll_pos),hl
  787 45FF    C9                      03               ret
  788                                          
  789                                          ; AY-Register A mit E beschreiben. Port-C-Unterbits bleiben null.
  790                                          ; AY-HELFER. Eingabe A=AY-Registernummer, E=Datenwert.
  791                                          ; Veraendert BC; erhaelt AF, DE, HL, IX und IY. Die Folge besteht nur aus
  792                                          ; LD, OUT und RET, daher bleiben auch die Flags erhalten.
  793                                          ; PPI A liefert den AY-Datenbus. PPI C Bit 7 ist BDIR, Bit 6 ist BC1:
  794                                          ; #c0 = 11 adressiert ein Register, #80 = 10 schreibt dessen Daten,
  795                                          ; #00 = 00 beendet die jeweilige Busphase. Der AY erzeugt danach selbst
  796                                          ; Ton; die CPU muss keine einzelnen Schwingungen nachbilden.
  797                                          ; Port-C-Unterbits bleiben null: Tastaturzeile 0, Kassettenmotor und
  798                                          ; Kassetten-Ausgang aus. Dieser Player bedient keine Tastaturabfrage.
  799 4600                                     ay_write:
  800 4600    01 00 F4                03               ld bc,#f400               ; PPI-Port A als AY-Datenbus
  801 4603    ED 79                   04               out (c),a                 ; AY-Registernummer auf den Datenbus legen
  802 4605    01 C0 F6                03               ld bc,#f6c0               ; Port C, BDIR=1 und BC1=1
  803 4608    ED 49                   04               out (c),c                 ; aktuellen Steuerwert C ausgeben (Phase oder Ruhe)
  804 460A    0E 00                   02               ld c,0                    ; Steuerwert null; der Port bleibt #f6xx
  805 460C    ED 49                   04               out (c),c                 ; aktuellen Steuerwert C ausgeben (Phase oder Ruhe)
  806 460E    06 F4                   02               ld b,#f4                  ; zurueck zu Port A, C bleibt 0
  807 4610    ED 59                   04               out (c),e                 ; Registerwert auf den AY-Datenbus legen
  808 4612    01 80 F6                03               ld bc,#f680               ; Port C, BDIR=1 und BC1=0 fuer Schreibphase
  809 4615    ED 49                   04               out (c),c                 ; aktuellen Steuerwert C ausgeben (Phase oder Ruhe)
  810 4617    0E 00                   02               ld c,0                    ; Steuerwert null; der Port bleibt #f6xx
  811 4619    ED 49                   04               out (c),c                 ; aktuellen Steuerwert C ausgeben (Phase oder Ruhe)
  812 461B    C9                      03               ret
  813                                          
  814                                          ; Lautstaerke sinkt im Finale waehrend der letzten 32 Bilder.
  815                                          ; AUSBLENDEN. Nur im Finale und nur bei weniger als 32 Restframes.
  816                                          ; volume_limit = floor(Restframes/2), also absteigend bis 0.
  817                                          ; Der Aufruf folgt music_tick; die neue Grenze wirkt deshalb beim
  818                                          ; naechsten Musikaufruf. show_complete setzt die Kanaele abschliessend stumm.
  819 461C                                     ending_volume:
  820 461C    3A BB 48                04               ld a,(scene)
  821 461F    FE 06                   02               cp 6
  822 4621    C0                      02               ret nz
  823 4622    2A C9 48                05               ld hl,(scene_length)
  824 4625    ED 5B BC 48             06               ld de,(scene_frame)
  825 4629    B7                      01               or a                      ; Carry fuer die folgende 16-Bit-Subtraktion loeschen
  826 462A    ED 52                   04               sbc hl,de                 ; Restframes = Szenenlaenge - bisherige Frames
  827 462C    7C                      01               ld a,h
  828 462D    B7                      01               or a                      ; Highbyte der Restzeit auf null pruefen
  829 462E    C0                      02               ret nz
  830 462F    7D                      01               ld a,l
  831 4630    FE 20                   02               cp 32
  832 4632    D0                      02               ret nc
  833 4633    CB 3F                   02               srl a                     ; zwei Frames je Lautstaerkestufe
  834 4635    32 BA 48                04               ld (volume_limit),a
  835 4638    C9                      03               ret
  836                                          ; LAUTSTAERKE MIT GRENZE. Eingabe A=8/9/10, E=gewuenschter Pegel 0..15.
  837                                          ; Bei R10 (Kanal C) teilen See und Split den Pegel zusaetzlich durch 4.
  838                                          ; AF wird vor dem Vergleich gesichert, weil A die AY-Registernummer traegt.
  839                                          ; CP E prueft volume_limit gegen E. Falls E groesser ist, ersetzt die
  840                                          ; Routine E durch die Grenze. Endaufruf von ay_write ueber JP.
  841 4639                                     volume_write:
  842 4639    FE 0A                   02               cp 10
  843 463B    20 11                   02               jr nz,volume_common
  844 463D    3A BB 48                04               ld a,(scene)
  845 4640    FE 01                   02               cp 1
  846 4642    28 04                   02               jr z,drums_quiet
  847 4644    FE 04                   02               cp 4
  848 4646    20 04                   02               jr nz,drums_full
  849 4648                                     drums_quiet:
  850 4648    CB 3B                   02               srl e
  851 464A    CB 3B                   02               srl e
  852 464C                                     drums_full:
  853 464C    3E 0A                   02               ld a,10
  854 464E                                     volume_common:
  855 464E    F5                      04               push af                   ; AY-Registernummer und Flags ueber Vergleich retten
  856 464F    3A BA 48                04               ld a,(volume_limit)
  857 4652    BB                      01               cp e                      ; Grenze mit angefordertem Pegel vergleichen
  858 4653    30 01                   02               jr nc,volume_keep         ; Grenze >= Pegel: E kann unveraendert bleiben
  859 4655    5F                      01               ld e,a                    ; sonst auf die globale Grenze begrenzen
  860 4656                                     volume_keep:
  861 4656    F1                      03               pop af                    ; AY-Registernummer wiederherstellen
  862 4657    C3 00 46                03               jp ay_write               ; Endaufruf: RET des Helfers geht direkt zum Aufrufer
  863                                          
  864                                          ; Eigene Komposition: 128 Sechzehntel, acht Frames pro Schritt.
  865                                          ; A Arpeggio, B pulsierender Bass, C Kick/Snare/Hi-Hat.
  866                                          ; MUSIK OHNE FIRMWARE. beat_frame zaehlt 0..7 innerhalb einer Note;
  867                                          ; song_step zaehlt die 128 Notenschritte. Ein Schritt dauert etwa 159,7 ms.
  868                                          ; Die Tabellen enthalten 16-Bit-Perioden, keine Frequenzen. Beim AY mit
  869                                          ; 1-MHz-Takt gilt fuer die Tonkanaele f = 1000000 / (16 * Periode).
  870                                          ; R0/R1 setzen Periode A, R2/R3 Periode B. Nur bei beat_frame=0 kommen
  871                                          ; neue Tonhoehen; die Lautstaerkekurven erhalten trotzdem jeden Frame Updates.
  872                                          ; E transportiert jeweils das Low- oder Highbyte an ay_write. Dieser
  873                                          ; Helfer erhaelt HL, daher kann der Notenzeiger zwischen den Writes bleiben.
  874 465A                                     music_tick:
  875 465A    3A C0 48                04               ld a,(beat_frame)
  876 465D    B7                      01               or a
  877 465E    20 2A                   02               jr nz,music_envelope
  878 4660    3A C1 48                04               ld a,(song_step)
  879 4663    87                      01               add a,a                   ; zwei Periodenbytes pro Notenschritt
  880 4664    5F                      01               ld e,a
  881 4665    16 00                   02               ld d,0
  882 4667    21 3C 49                03               ld hl,lead_notes
  883 466A    19                      03               add hl,de
  884 466B    D5                      04               push de                   ; Tabellenoffset fuer die anschliessende Bassnote sichern
  885 466C    5E                      02               ld e,(hl)
  886 466D    AF                      01               xor a                     ; AY R0: Lowbyte Tonperiode A
  887 466E    CD 00 46                05               call ay_write
  888 4671    23                      02               inc hl
  889 4672    5E                      02               ld e,(hl)
  890 4673    3E 01                   02               ld a,1                    ; AY R1: Highbyte Tonperiode A
  891 4675    CD 00 46                05               call ay_write
  892 4678    D1                      03               pop de
  893 4679    21 3C 4A                03               ld hl,bass_notes
  894 467C    19                      03               add hl,de
  895 467D    5E                      02               ld e,(hl)
  896 467E    3E 02                   02               ld a,2                    ; AY R2: Lowbyte Tonperiode B
  897 4680    CD 00 46                05               call ay_write
  898 4683    23                      02               inc hl
  899 4684    5E                      02               ld e,(hl)
  900 4685    3E 03                   02               ld a,3                    ; AY R3: Highbyte Tonperiode B
  901 4687    CD 00 46                05               call ay_write
  902                                          ; Software-Huellkurven: A faellt von 14 auf 7; B von 12 auf 9.
  903                                          ; Bit 4 der AY-Pegelregister bleibt null, also feste Pegel statt der
  904                                          ; Hardware-Huellkurve. Die Instrumentform entsteht durch diese Frame-Updates.
  905                                          ; song_step modulo 4 verteilt Kick, Hi-Hat, Snare, Hi-Hat auf Kanal C.
  906 468A                                     music_envelope:
  907 468A    3A C0 48                04               ld a,(beat_frame)
  908 468D    5F                      01               ld e,a
  909 468E    3E 0E                   02               ld a,14
  910 4690    93                      01               sub e
  911 4691    5F                      01               ld e,a
  912 4692    3E 08                   02               ld a,8
  913 4694    CD 39 46                05               call volume_write
  914 4697    3A C0 48                04               ld a,(beat_frame)
  915 469A    CB 3F                   02               srl a
  916 469C    5F                      01               ld e,a
  917 469D    3E 0C                   02               ld a,12
  918 469F    93                      01               sub e
  919 46A0    5F                      01               ld e,a
  920 46A1    3E 09                   02               ld a,9
  921 46A3    CD 39 46                05               call volume_write
  922 46A6    3A C1 48                04               ld a,(song_step)
  923 46A9    E6 03                   02               and 3
  924 46AB    28 18                   02               jr z,kick
  925 46AD    FE 02                   02               cp 2
  926 46AF    28 04                   02               jr z,snare
  927 46B1    1E 02                   02               ld e,2
  928 46B3    18 02                   03               jr noise_drum
  929 46B5                                     snare:
  930 46B5    1E 0E                   02               ld e,14
  931                                          ; R6 ist die Rauschperiode: 2 fuer kurze Hi-Hat, 14 fuer Snare.
  932                                          ; R7=#1c: Ton A/B an, Ton C aus; Rauschen A/B aus, Rauschen C an.
  933                                          ; In den sechs unteren Mixerbits bedeutet 1 jeweils DEAKTIVIERT.
  934                                          ; Die hier null gesetzten Port-Richtungsbits sind keine Lautstaerkebits.
  935 46B7                                     noise_drum:
  936 46B7    3E 06                   02               ld a,6
  937 46B9    CD 00 46                05               call ay_write
  938 46BC    3E 07                   02               ld a,7
  939 46BE    1E 1C                   02               ld e,#1c
  940 46C0    CD 00 46                05               call ay_write
  941 46C3    18 19                   03               jr drum_volume
  942                                          ; R7=#38: drei Tonkanaele an, alle Rauschpfade aus.
  943                                          ; Kanal C erhaelt Lowbyte 0, Highbyte beat_frame+3. Die Periode waechst
  944                                          ; von #0300 bis #0a00, die Frequenz sinkt: kurzer abfallender Bassdrum-Ton.
  945 46C5                                     kick:
  946 46C5    3E 07                   02               ld a,7
  947 46C7    1E 38                   02               ld e,#38
  948 46C9    CD 00 46                05               call ay_write
  949 46CC    3A C0 48                04               ld a,(beat_frame)
  950 46CF    C6 03                   02               add 3
  951 46D1    5F                      01               ld e,a
  952 46D2    3E 05                   02               ld a,5
  953 46D4    CD 00 46                05               call ay_write
  954 46D7    3E 04                   02               ld a,4
  955 46D9    1E 00                   02               ld e,0
  956 46DB    CD 00 46                05               call ay_write
  957                                          ; Schlagzeugpegel 14 - 2*beat_frame: 14,12,...,0.
  958                                          ; AND 7 setzt beat_frame nach acht Aufrufen auf null. Nur dann laeuft
  959                                          ; song_step weiter; AND 127 laesst die 128-Schritt-Komposition wiederholen.
  960 46DE                                      drum_volume:
  961 46DE    3A C0 48                04               ld a,(beat_frame)
  962 46E1    87                      01               add a,a
  963 46E2    5F                      01               ld e,a
  964 46E3    3E 0E                   02               ld a,14
  965 46E5    93                      01               sub e
  966 46E6    5F                      01               ld e,a
  967 46E7    3E 0A                   02               ld a,10
  968 46E9    CD 39 46                05               call volume_write
  969 46EC    3A C0 48                04               ld a,(beat_frame)
  970 46EF    3C                      01               inc a
  971 46F0    E6 07                   02               and 7
  972 46F2    32 C0 48                04               ld (beat_frame),a
  973 46F5    C0                      02               ret nz
  974 46F6    3A C1 48                04               ld a,(song_step)
  975 46F9    3C                      01               inc a
  976 46FA    E6 7F                   02               and 127
  977 46FC    32 C1 48                04               ld (song_step),a
  978 46FF    C9                      03               ret
